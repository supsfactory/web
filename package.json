{
  "name": "supsfactory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm build && wrangler deploy",
    "deploy:prod": "CLOUDFLARE_ENV=production pnpm build && wrangler deploy",
    "deploy:purge": "node scripts/purge-cache.mjs",
    "deploy:prod:all": "pnpm deploy:prod && pnpm deploy:purge",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ${npm_config_site_id:-supsfactory}-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply ${npm_config_site_id:-supsfactory}-db-staging --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply ${npm_config_site_id:-supsfactory}-db-prod --env production --remote",
    "db:seed:local": "wrangler d1 execute ${npm_config_site_id:-supsfactory}-db --local --file=./scripts/demo.sql",
    "db:seed:framework:local": "wrangler d1 execute ${npm_config_site_id:-supsfactory}-db --local --file=./scripts/framework.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate:local && pnpm db:seed:local",
    "upload:images": "node scripts/upload-afarer-images.mjs",
    "upload:site-assets": "node scripts/upload-site-assets.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@orama/stopwords": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/cloudflare": "^10.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "better-auth": "^1.6.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fumadocs-core": "^16.14.4",
    "fumadocs-mdx": "^15.0.13",
    "fumadocs-ui": "^16.10.6",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "vaul": "^1.1.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-router-devtools": "1.167.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "undici": "^7.29.0",
      "brace-expansion": "^5.0.9",
      "esbuild": "^0.25.0",
      "sharp": "^0.35.0",
      "js-yaml@^4": "^4.3.1",
      "js-yaml@^5": "^5.2.2"
    }
  }
}
