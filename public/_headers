# Cache headers for Cloudflare Static Assets (served before the Worker).
# Hashed build outputs (/assets/index-*.js, app-*.css) never change per URL - serve as immutable for a year. Fonts carry no hash, so keep a shorter 7-day window.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/fonts/*.woff2
  Cache-Control: public, max-age=604800

# 质量照片/视频/PDF：源文件仍随仓库提交，供工作流上传到 R2
# （CDN: assets.supsfactory.com/site/*）；旧路径保持可访问，缓存头不变。
/assets/quality/*.jpg
  Cache-Control: public, max-age=604800

/assets/quality/*.webp
  Cache-Control: public, max-age=604800

/assets/quality/*.avif
  Cache-Control: public, max-age=604800

/assets/products/*
  Cache-Control: public, max-age=604800

/assets/products/*/*
  Cache-Control: public, max-age=604800

/assets/videos/*
  Cache-Control: public, max-age=604800

/downloads/*.pdf
  Cache-Control: public, max-age=3600
