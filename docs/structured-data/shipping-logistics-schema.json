{
  "description": "Shipping and logistics schema for SUP manufacturing B2B orders",
  "type": "object",
  "properties": {
    "order": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Unique order identifier"
        },
        "orderDate": {
          "type": "string",
          "format": "date",
          "description": "Date order was placed"
        },
        "expectedShipDate": {
          "type": "string",
          "format": "date",
          "description": "Expected shipment date"
        },
        "shipTo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Consignee name"
            },
            "company": {
              "type": "string",
              "description": "Company name"
            },
            "address": {
              "type": "object",
              "properties": {
                "streetAddress": {
                  "type": "string",
                  "description": "Street address"
                },
                "addressLocality": {
                  "type": "string",
                  "description": "City"
                },
                "addressRegion": {
                  "type": "string",
                  "description": "State/Province"
                },
                "addressCountry": {
                  "type": "string",
                  "description": "Country"
                }
              },
              "required": ["addressLocality", "addressCountry"]
            }
          }
        }
      },
      "required": ["orderId", "shipTo"]
    },
    "shippingMethods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "methodName": {
            "type": "string",
            "description": "Shipping method name (e.g., 'Air Freight', 'Sea Freight', 'Express')"
          },
          "carrier": {
            "type": "string",
            "description": "Carrier name (e.g., 'DHL', 'FedEx', 'MAERSK')"
          },
          "deliveryTime": {
            "type": "string",
            "description": "Expected delivery timeframe"
          },
          "cost": {
            "type": "string",
            "description": "Shipping cost"
          },
          "weightLimit": {
            "type": "string",
            "description": "Maximum weight limit for this method"
          },
          "dimensionsLimit": {
            "type": "string",
            "description": "Maximum dimensions allowed"
          },
          "tracking": {
            "type": "boolean",
            "description": "Whether tracking is provided"
          }
        },
        "required": ["methodName", "carrier"]
      },
      "description": "Available shipping methods for orders"
    },
    "shippingTerms": {
      "type": "object",
      "properties": {
        "incoterms": {
          "type": "string",
          "description": "International Commercial Terms (e.g., 'EXW', 'FOB', 'CIF')"
        },
        "responsibility": {
          "type": "string",
          "description": "Description of shipping responsibilities"
        },
        "insurance": {
          "type": "boolean",
          "description": "Whether shipping insurance is included"
        },
        "trackingUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL for tracking shipments"
        }
      },
      "description": "Shipping terms and conditions"
    },
    "logisticsCapabilities": {
      "type": "object",
      "properties": {
        "exportExperience": {
          "type": "integer",
            "description": "Years of export experience"
        },
        "exportCountries": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Countries regularly shipping to"
          },
          "description": "List of countries regularly shipping to"
        },
        "documentationProvided": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "List of documentation provided with shipments"
          },
          "description": "Documentation typically provided with shipments"
        },
        "customsBrokerage": {
          "type": "boolean",
          "description": "Whether customs brokerage services are offered"
        }
      },
      "description": "Logistics capabilities and experience"
    }
  }
}