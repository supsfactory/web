{
  "description": "Brand heritage and history schema for SUP manufacturing companies",
  "type": "object",
  "properties": {
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Brand name (e.g., 'SUPsfactory')"
        },
        "foundingDate": {
          "type": "string",
          "format": "date",
          "description": "Company founding date (e.g., '2012-01-01')"
        },
        "foundingStory": {
          "type": "string",
          "description": "Brief story of how the company was founded"
        },
        "founder": {
          "type": "string",
          "description": "Founder name(s)"
        },
        "headquarters": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string",
              "description": "City of headquarters"
            },
            "city": "Qingdao",
            "region": {
              "type": "string",
              "description": "Region/State"
            },
            "country": {
              "type": "string",
              "description": "Country (e.g., 'China')"
            }
          },
          "required": ["city", "country"]
        },
        "historyHighlights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "description": "Year of the event"
              },
              "event": {
                "type": "string",
                "description": "Description of the historical event"
              }
            }
          },
          "description": "Key milestones in company history"
        }
      },
      "required": ["name", "foundingDate", "headquarters"]
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "milestone": {
            "type": "string",
            "description": "Description of the milestone"
          },
          "year": {
            "type": "integer",
            "description": "Year the milestone was achieved"
          },
          "impact": {
            "type": "string",
            "description": "Business impact of this milestone"
          }
        }
      },
      "description": "Key company milestones"
    },
    "certificationsTimeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "certification": {
            "type": "string",
            "description": "Certification name (e.g., 'ISO 9001')"
          },
          "obtainedYear": {
            "type": "integer",
            "description": "Year certification was obtained"
          },
          "validUntil": {
            "type": "string",
            "format": "date",
            "description": "Expiration date if applicable"
          }
        }
      },
      "description": "Certification acquisition timeline"
    },
    "manufacturingExperience": {
      "type": "object",
      "properties": {
        "yearsInOperation": {
          "type": "integer",
          "description": "Total years in operation"
        },
        "annualProductionCapacity": {
          "type": "integer",
          "description": "Annual production capacity"
        },
        "totalUnitsProduced": {
          "type": "integer",
          "description": "Total units produced since founding"
        },
        "countriesExportedTo": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Country names"
          },
          "description": "Number of countries products are exported to"
        }
      },
      "description": "Manufacturing experience metrics"
    }
  }
}