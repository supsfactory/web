{
  "description": "Factory capabilities structured data for SUPsfactory manufacturing facility",
  "type": "object",
  "properties": {
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Company name (e.g., 'SUPsfactory')"
        },
        "description": {
          "type": "string",
          "description": "Company description"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Company website URL"
        },
        "logo": {
          "type": "string",
          "format": "uri",
          "description": "URL to company logo"
        }
      },
      "required": ["name", "url"]
    },
    "manufacturingFacility": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Facility name (e.g., 'SUPsfactory Factory')"
        },
        "type": {
          "type": "string",
          "description": "Type of facility (e.g., 'Inflatable SUP manufacturing plant')"
        },
        "address": {
          "type": "object",
          "properties": {
            "streetAddress": {
              "type": "string",
              "description": "Street address"
            },
            "addressLocality": {
              "type": "string",
              "description": "City"
            },
            "addressRegion": {
              "type": "string",
              "description": "State/Province"
            },
            "addressCountry": {
              "type": "string",
              "description": "Country"
            }
          },
          "required": ["addressLocality", "addressCountry"]
        },
        "geo": {
          "type": "object",
          "properties": {
            "@type": {
              "type": "string",
              "description": "'GeoCoordinates'"
            },
            "latitude": {
              "type": "number",
              "description": "Latitude in decimal degrees"
            },
            "longitude": {
              "type": "number",
              "description": "Longitude in decimal degrees"
            }
          },
          "required": ["latitude", "longitude"]
        }
      },
      "required": ["name"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Capability name (e.g., 'OEM manufacturing', 'Private labeling')"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the capability"
        },
        "minOrderQuantity": {
          "type": "string",
          "description": "Minimum order quantity for this capability"
        },
        "leadTime": {
          "type": "string",
          "description": "Typical lead time for this capability"
        }
      },
      "description": "Array of manufacturing capabilities"
    },
    "productionStats": {
      "type": "object",
      "properties": {
        "annualCapacity": {
          "type": "string",
          "description": "Annual production capacity (e.g., '120,000+ boards per year')"
        },
        "productionLines": {
          "type": "integer",
          "description": "Number of production lines"
        },
        "workforce": {
          "type": "string",
          "description": "Number of employees (e.g., '50-100 skilled workers')"
        },
        "qualityControl": {
          "type": "string",
          "description": "Quality control processes and certifications"
        }
      },
      "description": "Production statistics and quality metrics"
    },
    "productsManufactured": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productName": {
            "type": "string",
            "description": "Name of manufactured product"
          },
          "productSku": {
            "type": "string",
            "description": "Product SKU"
          },
          "annualVolume": {
            "type": "string",
            "description": "Annual production volume for this product"
          }
        },
        "required": ["productName"]
      },
      "description": "Products manufactured at this facility"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Certification name (e.g., 'ISO 9001')"
          },
          "description": {
            "type": "string",
            "description": "Certification description"
          },
          "issuedBy": {
            "type": "string",
            "description": "Certifying body"
          },
          "issueDate": {
            "type": "string",
            "format": "date",
            "description": "Date certification was issued"
          }
        },
        "required": ["name"]
      },
      "description": "List of certifications held by the facility"
    },
    "exportRegions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Countries or regions products are exported to"
      },
      "description": "Geographic market coverage"
    }
  },
  "required": ["company", "manufacturingFacility", "capabilities", "productionStats"]
}