{
  "description": "CaseStudy schema structure for SUPsfactory project case studies",
  "type": "object",
  "required": ["@type", "name", "url"],
  "properties": {
    "@type": {
      "type": "string",
      "enum": ["CaseStudy"],
      "description": "Schema.org CaseStudy type"
    },
    "name": {
      "type": "string",
      "description": "Title of the case study (e.g., 'European SUP Brand Launch')"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the case study page"
    },
    "author": {
      "type": "object",
      "properties": {
        "@type": "Organization",
        "name": {
          "type": "string",
          "description": "Organization name"
        }
      },
      "description": "Author of the case study"
    },
    "subjectOf": {
      "type": "object",
      "properties": {
        "@type": "Organization",
        "name": {
          "type": "string",
          "description": "Company name"
        }
      },
      "description": "The company the case study is about"
    },
    "industry": {
      "type": "string",
      "description": "Industry the case study relates to (e.g., 'SUP manufacturing')"
    },
    "review": {
      "type": "object",
      "properties": {
        "@type": "Review",
        "author": {
          "@type": "Person",
          "name": {
            "type": "string",
            "description": "Reviewer name"
          }
        },
        "reviewRating": {
          "@type": "Rating",
          "properties": {
            "ratingValue": {
              "type": "number",
              "description": "Rating value (1-5)"
            },
            "bestRating": {
              "type": "number",
              "description": "Best possible rating"
            },
            "worstRating": {
              "type": "number",
              "description": "Worst possible rating"
            }
          }
        },
        "description": {
          "type": "string",
          "description": "Review text"
        }
      },
      "description": "Optional review of the case study results"
    },
    "participant": {
      "type": "object",
      "properties": {
        "@type": "Organization",
        "name": {
          "type": "string",
          "description": "Client company name"
        }
      },
      "description": "The client company in the case study"
    },
    "event": {
      "type": "object",
      "properties": {
        "@type": "Event",
        "name": {
          "type": "string",
          "description": "Event name related to the case study"
        },
        "description": {
          "type": "string",
          "description": "Event description"
        },
        "startDate": {
          "type": "string",
          "format": "date-time",
          "description": "Event start date"
        },
        "endDate": {
          "type": "string",
          "format": "date-time",
          "description": "Event end date"
        }
      },
      "description": "Optional event related to the case study"
    },
    "supply": {
      "type": "object",
      "properties": {
        "@type": "Product",
        "name": {
          "type": "string",
          "description": "Product used in the case study"
        },
        "sku": {
          "type": "string",
          "description": "Product SKU"
        },
        "description": {
          "type": "string",
          "description": "Product description"
        }
      },
      "description": "Product used in the case study"
    },
    "result": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Result title (e.g., 'Increased Production by 300%')"
        },
        "description": {
          "type": "string",
          "description": "Detailed result description"
        }
      },
      "description": "Measurable results from the case study"
    },
    "duration": {
      "type": "string",
      "description": "Duration of the project (e.g., '6 months', '12 weeks')"
    },
    "supplyChain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Supply chain partner name"
          },
          "role": {
            "type": "string",
            "description": "Role in the supply chain"
          }
        },
        "description": {
          "type": "string",
          "description": "Description of the supply chain partner's role"
        }
      },
      "description": "Supply chain partners involved in the project"
    },
    "keyTakeaway": {
      "type": "string",
      "description": "Primary learning or outcome from the case study"
    }
  }
}